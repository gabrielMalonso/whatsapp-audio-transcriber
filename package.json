{
  "name": "whatsapp-audio-transcriber",
  "private": true,
  "version": "0.2.3",
  "description": "Open-source extension for Chrome, Firefox, and Zen that transcribes WhatsApp Web voice messages with Groq.",
  "license": "MIT",
  "author": "Gabriel Alonso",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielMalonso/whatsapp-audio-transcriber.git"
  },
  "bugs": {
    "url": "https://github.com/gabrielMalonso/whatsapp-audio-transcriber/issues"
  },
  "homepage": "https://github.com/gabrielMalonso/whatsapp-audio-transcriber#readme",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @wat/protocol build && pnpm --filter @wat/extension build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm build:firefox",
    "dev": "pnpm --filter @wat/extension dev",
    "prepare": "pnpm --filter @wat/protocol build && pnpm --filter @wat/extension prepare",
    "test": "pnpm --filter @wat/protocol test && pnpm --filter @wat/extension test",
    "typecheck": "pnpm --filter @wat/protocol typecheck && pnpm --filter @wat/extension typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "store:package": "pnpm --filter @wat/protocol build && pnpm --filter @wat/extension exec wxt zip && node scripts/package-store.mjs",
    "version:extension": "node scripts/version-extension.mjs",
    "build:chrome": "pnpm --filter @wat/protocol build && pnpm --filter @wat/extension build",
    "build:firefox": "pnpm --filter @wat/protocol build && pnpm --filter @wat/extension build:firefox",
    "build:zen": "pnpm build:firefox",
    "dev:chrome": "pnpm --filter @wat/extension dev",
    "dev:firefox": "pnpm --filter @wat/extension dev:firefox",
    "dev:zen": "pnpm dev:firefox",
    "zip:chrome": "pnpm --filter @wat/protocol build && pnpm --filter @wat/extension zip:chrome",
    "zip:firefox": "pnpm --filter @wat/protocol build && pnpm --filter @wat/extension zip:firefox",
    "zip:zen": "pnpm zip:firefox"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "3.9.6",
    "typescript-eslint": "^8.66.0"
  }
}
